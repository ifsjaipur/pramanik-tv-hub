# --- YouTube ---
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Fallback keys (optional) - used when primary key quota is exceeded
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=

# YouTube Channel IDs (UCxxxxxx format, not handles)
YOUTUBE_CHANNEL_ID_PRAMANSAGARJI=UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID_BESTOFSHANKA=UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID_JAINPATHSHALA=UCxxxxxxxxxxxxxxxxxxxxxxxx

# --- Redis ---
# Self-hosted (docker-compose): redis://:password@redis:6379
# Local dev without Docker: redis://:password@localhost:6379
# Leave empty to run without caching (YouTube API called directly)
REDIS_URL=redis://:pramanik_redis_secret@redis:6379
REDIS_PASSWORD=pramanik_redis_secret

# --- App Config ---
NEXT_PUBLIC_SITE_URL=https://watch.munipramansagar.net
NEXT_PUBLIC_SITE_NAME=Pramanik Video Hub
NEXT_PUBLIC_SITE_NAME_HI=प्रमाणिक विडियो हब

# Cache duration in seconds (3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Revalidation secret (generate a random string, use in Coolify webhook)
REVALIDATE_SECRET=generate_a_long_random_string_here

# --- Analytics (optional) ---
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_URL=
